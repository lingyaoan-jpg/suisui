<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface"
        android:paddingHorizontal="@dimen/padding_md"
        android:elevation="2dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_left" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="@dimen/text_lg"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:gravity="center"
            tools:text="小明的小世界" />

        <!-- 菜单按钮（拉黑等） -->
        <ImageButton
            android:id="@+id/btn_menu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_filter"
            android:rotation="90"
            android:contentDescription="更多" />
    </LinearLayout>

    <!-- 可滚动内容（复用小世界布局结构，无底部输入框） -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- 背景图 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/bg_height">

                <ImageView
                    android:id="@+id/iv_background"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_avatar_placeholder" />
            </FrameLayout>

            <!-- 头像 + 昵称 + 订阅按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/padding_lg"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"
                android:background="@color/surface"
                android:clipChildren="false"
                android:clipToPadding="false">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/iv_avatar"
                    android:layout_width="@dimen/avatar_size"
                    android:layout_height="@dimen/avatar_size"
                    android:src="@drawable/bg_avatar_placeholder"
                    app:civ_border_width="2dp"
                    app:civ_border_color="@color/white"
                    android:layout_marginTop="-20dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/padding_md">

                    <TextView
                        android:id="@+id/tv_nickname"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_lg"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        tools:text="小明" />

                    <TextView
                        android:id="@+id/tv_subscriber_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_xs"
                        android:textColor="@color/text_secondary"
                        tools:text="56 订阅者" />
                </LinearLayout>

                <!-- 订阅按钮 -->
                <Button
                    android:id="@+id/btn_subscribe"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:minWidth="80dp"
                    android:textSize="@dimen/text_md"
                    android:paddingHorizontal="20dp"
                    android:stateListAnimator="@null"
                    tools:text="订阅" />
            </LinearLayout>

            <!-- 个人介绍 -->
            <TextView
                android:id="@+id/tv_bio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/padding_lg"
                android:paddingBottom="@dimen/padding_md"
                android:textSize="@dimen/text_sm"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="4dp"
                android:background="@color/surface"
                tools:text="这是我的小世界 🌍" />

            <!-- 分割 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:background="@color/background" />

            <!-- 碎碎念列表 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_moments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingTop="@dimen/padding_sm"
                android:paddingBottom="@dimen/padding_xl"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_moment_card" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
