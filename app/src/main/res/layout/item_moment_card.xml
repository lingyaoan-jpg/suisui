<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/padding_md"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="@dimen/card_radius"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/card_background"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_md">

        <!-- 顶部：用户信息 + 删除按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/padding_sm">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/iv_user_avatar"
                android:layout_width="@dimen/avatar_size_xs"
                android:layout_height="@dimen/avatar_size_xs"
                android:src="@drawable/bg_avatar_placeholder"
                app:civ_border_width="0dp" />

            <TextView
                android:id="@+id/tv_user_nickname"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/padding_sm"
                android:textSize="@dimen/text_sm"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                tools:text="碎碎念小主" />

            <TextView
                android:id="@+id/tv_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_xs"
                android:textColor="@color/text_secondary"
                android:layout_marginEnd="@dimen/padding_sm"
                tools:text="3小时前" />

            <!-- 删除按钮（仅自己可见） -->
            <ImageButton
                android:id="@+id/btn_delete"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_delete"
                android:scaleType="centerInside"
                android:visibility="gone"
                android:contentDescription="@string/delete"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- 文字内容 -->
        <TextView
            android:id="@+id/tv_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_md"
            android:textColor="@color/text_primary"
            android:lineSpacingExtra="4dp"
            android:maxLines="5"
            android:ellipsize="end"
            tools:text="今天天气真好，出门散步晒太阳☀️ 感觉整个人都充满能量了！" />

        <!-- 查看全部按钮 -->
        <TextView
            android:id="@+id/tv_view_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/view_all"
            android:textSize="@dimen/text_sm"
            android:textColor="@color/primary"
            android:paddingTop="4dp"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- 图片缩略图区（三列） -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_images"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_sm"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="3"
            tools:listitem="@layout/item_image_thumbnail"
            tools:visibility="visible" />

        <!-- 标签 -->
        <LinearLayout
            android:id="@+id/layout_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/padding_sm"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tv_tag1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_chip"
                android:textColor="@color/tag_text"
                android:textSize="@dimen/text_xs"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:layout_marginEnd="6dp"
                tools:text="日常" />

            <TextView
                android:id="@+id/tv_tag2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_chip"
                android:textColor="@color/tag_text"
                android:textSize="@dimen/text_xs"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:layout_marginEnd="6dp"
                android:visibility="gone"
                tools:text="感悟"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- 分割线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/divider"
            android:layout_marginTop="@dimen/padding_sm" />

        <!-- 底部：点赞 + 评论 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/padding_sm">

            <LinearLayout
                android:id="@+id/btn_like"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:paddingHorizontal="@dimen/padding_sm"
                android:paddingVertical="4dp">

                <ImageView
                    android:id="@+id/iv_like"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_like" />

                <TextView
                    android:id="@+id/tv_like_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textSize="@dimen/text_sm"
                    android:textColor="@color/text_secondary"
                    tools:text="12" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_comment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:paddingHorizontal="@dimen/padding_sm"
                android:paddingVertical="4dp"
                android:layout_marginStart="@dimen/padding_sm">

                <ImageView
                    android:id="@+id/iv_comment"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_comment" />

                <TextView
                    android:id="@+id/tv_comment_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textSize="@dimen/text_sm"
                    android:textColor="@color/text_secondary"
                    tools:text="3" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
