<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/padding_xl">

        <!-- 用户信息头部 -->
        <LinearLayout
            android:id="@+id/layout_user_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="@dimen/padding_lg"
            android:background="@color/surface"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/iv_avatar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/bg_avatar_placeholder" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="@dimen/padding_md">

                <TextView
                    android:id="@+id/tv_nickname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_lg"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    tools:text="碎碎念小主" />

                <TextView
                    android:id="@+id/tv_username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_xs"
                    android:textColor="@color/text_secondary"
                    tools:text="@suisui_user" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_arrow_left"
                android:rotation="180"
                android:alpha="0.3" />
        </LinearLayout>

        <!-- 分割 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:background="@color/background" />

        <!-- 世界公开开关 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/padding_lg"
            android:paddingVertical="@dimen/padding_md"
            android:background="@color/surface">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/world_public_switch"
                    android:textSize="@dimen/text_md"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/world_public_desc"
                    android:textSize="@dimen/text_xs"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_public"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                app:thumbTint="@color/white"
                app:trackTint="@color/primary_light"
                app:trackTintMode="src_in" />
        </LinearLayout>

        <!-- 分割 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/divider"
            android:layout_marginStart="@dimen/padding_lg" />

        <!-- 通知中心 -->
        <LinearLayout
            android:id="@+id/btn_notifications"
            style="@style/SettingRow"
            android:layout_marginTop="8dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_notification"
                android:layout_marginEnd="@dimen/padding_md" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/notification_center"
                android:textSize="@dimen/text_md"
                android:textColor="@color/text_primary" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_arrow_left"
                android:rotation="180"
                android:alpha="0.3" />
        </LinearLayout>

        <!-- 数据统计 -->
        <LinearLayout
            android:id="@+id/btn_statistics"
            style="@style/SettingRow">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_discover"
                android:layout_marginEnd="@dimen/padding_md" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/data_statistics"
                android:textSize="@dimen/text_md"
                android:textColor="@color/text_primary" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_arrow_left"
                android:rotation="180"
                android:alpha="0.3" />
        </LinearLayout>

        <!-- 订阅管理 -->
        <LinearLayout
            android:id="@+id/btn_subscription_manage"
            style="@style/SettingRow">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_subscribe"
                android:layout_marginEnd="@dimen/padding_md" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/subscription_manage"
                android:textSize="@dimen/text_md"
                android:textColor="@color/text_primary" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_arrow_left"
                android:rotation="180"
                android:alpha="0.3" />
        </LinearLayout>

        <!-- 黑名单管理 -->
        <LinearLayout
            android:id="@+id/btn_blacklist"
            style="@style/SettingRow">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_delete"
                android:layout_marginEnd="@dimen/padding_md" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/blacklist_manage"
                android:textSize="@dimen/text_md"
                android:textColor="@color/text_primary" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_arrow_left"
                android:rotation="180"
                android:alpha="0.3" />
        </LinearLayout>

        <!-- 分割 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:background="@color/background" />

        <!-- 手动导出数据 -->
        <LinearLayout
            android:id="@+id/btn_export"
            style="@style/SettingRow">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_send"
                android:layout_marginEnd="@dimen/padding_md" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/export_data"
                android:textSize="@dimen/text_md"
                android:textColor="@color/text_primary" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_arrow_left"
                android:rotation="180"
                android:alpha="0.3" />
        </LinearLayout>

        <!-- 账号设置 -->
        <LinearLayout
            android:id="@+id/btn_account_settings"
            style="@style/SettingRow">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_me"
                android:layout_marginEnd="@dimen/padding_md" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/account_settings"
                android:textSize="@dimen/text_md"
                android:textColor="@color/text_primary" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_arrow_left"
                android:rotation="180"
                android:alpha="0.3" />
        </LinearLayout>

        <!-- 关于/帮助 -->
        <LinearLayout
            android:id="@+id/btn_about"
            style="@style/SettingRow">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_world"
                android:layout_marginEnd="@dimen/padding_md" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/about_help"
                android:textSize="@dimen/text_md"
                android:textColor="@color/text_primary" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_arrow_left"
                android:rotation="180"
                android:alpha="0.3" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
