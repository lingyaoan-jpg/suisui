<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 可滚动内容区 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- 顶部背景图区域 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/bg_height">

                <ImageView
                    android:id="@+id/iv_background"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_avatar_placeholder"
                    tools:src="@mipmap/ic_launcher" />

                <ImageButton
                    android:id="@+id/btn_edit_bg"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_card"
                    android:src="@drawable/ic_add_photo"
                    android:scaleType="centerInside"
                    android:padding="6dp"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </FrameLayout>

            <!-- 头像 + 昵称 + 按钮区 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/padding_lg"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"
                android:background="@color/surface"
                android:clipChildren="false"
                android:clipToPadding="false">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/iv_avatar"
                    android:layout_width="@dimen/avatar_size"
                    android:layout_height="@dimen/avatar_size"
                    android:src="@drawable/bg_avatar_placeholder"
                    app:civ_border_width="2dp"
                    app:civ_border_color="@color/white"
                    android:layout_marginTop="-20dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/padding_md">

                    <TextView
                        android:id="@+id/tv_nickname"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_lg"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        tools:text="碎碎念小主" />

                    <TextView
                        android:id="@+id/tv_subscriber_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_xs"
                        android:textColor="@color/text_secondary"
                        tools:text="128 订阅者" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_action"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:minWidth="90dp"
                    android:text="@string/edit_profile"
                    android:textSize="@dimen/text_md"
                    android:textColor="@color/primary"
                    android:background="@drawable/bg_button_outline"
                    android:paddingHorizontal="20dp"
                    android:stateListAnimator="@null"
                    tools:text="编辑资料" />
            </LinearLayout>

            <!-- 个人介绍 -->
            <TextView
                android:id="@+id/tv_bio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/padding_lg"
                android:paddingBottom="@dimen/padding_md"
                android:textSize="@dimen/text_sm"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="4dp"
                android:background="@color/surface"
                tools:text="记录生活的小确幸 ✨\n热爱美食、旅行和一切美好的事物。" />

            <!-- 分割线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:background="@color/background" />

            <!-- 碎碎念标题栏 + 筛选按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/surface"
                android:paddingHorizontal="@dimen/padding_lg"
                android:paddingVertical="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="碎碎念"
                    android:textSize="@dimen/text_md"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btn_filter"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_filter"
                    android:scaleType="centerInside"
                    android:contentDescription="筛选" />
            </LinearLayout>

            <!-- 标签过滤栏（点击筛选按钮展开） -->
            <LinearLayout
                android:id="@+id/layout_tag_filter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/padding_lg"
                android:paddingVertical="@dimen/padding_sm"
                android:background="@color/surface"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_by_tag"
                    android:textSize="@dimen/text_sm"
                    android:textColor="@color/text_secondary"
                    android:layout_marginEnd="@dimen/padding_sm" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_tag_filter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_tag_chip" />
            </LinearLayout>

            <!-- 分割线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/divider" />

            <!-- 碎碎念列表 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_moments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingTop="@dimen/padding_sm"
                android:paddingBottom="@dimen/padding_lg"
                android:clipToPadding="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_moment_card" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- 选中图片预览区 -->
    <HorizontalScrollView
        android:id="@+id/layout_image_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:paddingHorizontal="@dimen/padding_md"
        android:paddingBottom="@dimen/padding_sm"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/container_preview_images"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- 底部发布输入框 -->
    <LinearLayout
        android:id="@+id/layout_input_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface"
        android:paddingHorizontal="@dimen/padding_md"
        android:paddingVertical="@dimen/padding_sm"
        android:elevation="12dp">

        <EditText
            android:id="@+id/et_input"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_bar"
            android:hint="@string/hint_input"
            android:textSize="@dimen/text_sm"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:paddingHorizontal="@dimen/padding_md"
            android:maxLines="3"
            android:inputType="textMultiLine" />

        <ImageButton
            android:id="@+id/btn_tag"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_tag"
            android:scaleType="centerInside"
            android:contentDescription="@string/add_tag" />

        <ImageButton
            android:id="@+id/btn_add_image"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_add_photo"
            android:scaleType="centerInside"
            android:contentDescription="@string/add_image" />

        <ImageButton
            android:id="@+id/btn_send"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_send"
            android:scaleType="centerInside"
            android:contentDescription="@string/send" />

    </LinearLayout>

</LinearLayout>
