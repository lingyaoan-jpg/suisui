<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/padding_md"
    app:cardCornerRadius="@dimen/card_radius"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/card_background"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:clipChildren="false"
    android:clipToPadding="false"
    app:cardPreventCornerOverlap="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- 背景图 -->
        <ImageView
            android:id="@+id/iv_background"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_avatar_placeholder" />

        <!-- 用户信息区 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/padding_md"
            android:paddingVertical="@dimen/padding_md">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/iv_avatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/bg_avatar_placeholder"
                app:civ_border_width="2dp"
                app:civ_border_color="@color/white"
                android:layout_marginTop="0dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="@dimen/padding_sm">

                <TextView
                    android:id="@+id/tv_nickname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_md"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    tools:text="小明" />

                <TextView
                    android:id="@+id/tv_active_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_xs"
                    android:textColor="@color/text_secondary"
                    tools:text="3小时前活跃" />
            </LinearLayout>

            <!-- 订阅状态标签 -->
            <TextView
                android:id="@+id/tv_subscribed_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/subscribed"
                android:textSize="10sp"
                android:textColor="@color/primary"
                android:background="@drawable/bg_tag_chip"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- 最近一条碎碎念预览 -->
        <TextView
            android:id="@+id/tv_latest_moment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/padding_md"
            android:paddingBottom="@dimen/padding_md"
            android:textSize="@dimen/text_sm"
            android:textColor="@color/text_secondary"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone"
            tools:text="今天天气真好，出门散步晒太阳..."
            tools:visibility="visible" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
