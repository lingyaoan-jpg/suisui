<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Suisui"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- 登录页 -->
        <activity
            android:name="com.suisui.app.ui.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 主页面 - 底部三Tab导航 -->
        <activity
            android:name="com.suisui.app.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 碎碎念详情页 -->
        <activity
            android:name="com.suisui.app.ui.world.MomentDetailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 他人小世界 -->
        <activity
            android:name="com.suisui.app.ui.discover.OtherWorldActivity"
            android:exported="false" />

        <!-- 编辑个人资料 -->
        <activity
            android:name="com.suisui.app.ui.me.EditProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 通知中心 -->
        <activity
            android:name="com.suisui.app.ui.me.NotificationActivity"
            android:exported="false" />

        <!-- 数据统计 -->
        <activity
            android:name="com.suisui.app.ui.me.StatisticsActivity"
            android:exported="false" />

        <!-- 订阅管理 -->
        <activity
            android:name="com.suisui.app.ui.me.SubscriptionManageActivity"
            android:exported="false" />

        <!-- 黑名单管理 -->
        <activity
            android:name="com.suisui.app.ui.me.BlacklistManageActivity"
            android:exported="false" />

        <!-- 账号设置 -->
        <activity
            android:name="com.suisui.app.ui.me.AccountSettingsActivity"
            android:exported="false" />

        <!-- 全屏图片预览 -->
        <activity
            android:name="com.suisui.app.ui.ImagePreviewActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

    </application>

</manifest>
